# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtualenv
.venv/
venv/

# Env / secrets — .env.example is the committed template, .env holds real values
.env
.env.*
!.env.example

# Local databases (SQLite fallback / stray dumps)
*.db
*.sqlite
*.sqlite3

# Test / lint / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs (e.g. the deployable-tasks cron job's own log file — see README.md)
*.log

# Claude Code: settings.json and skills are shared project config, kept tracked —
# settings.local.json is the personal/per-machine permission layer, never shared.
.claude/settings.local.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
