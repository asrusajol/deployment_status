APP_NAME="Deployment Tracker"

# Postgres for local dev too now (matches production, avoids dialect drift).
# POSTGRES_USER/PASSWORD/DB below are read by docker-compose.yml itself (both the `db`
# service's own credentials and the `app` service's DATABASE_URL are built from these same
# three values, so they can never drift out of sync) — MUST be overridden with a real
# password in every deployment; "changeme" is a local-dev-only fallback.
POSTGRES_USER=deploy_tracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=deploy_tracker

# Only used when running the app directly (`uvicorn app.main:app --reload`, outside
# Docker) — under docker-compose, DATABASE_URL is instead constructed from the
# POSTGRES_* values above (see docker-compose.yml), so keep this in sync with them.
DATABASE_URL=postgresql+psycopg2://deploy_tracker:changeme@localhost:5432/deploy_tracker

# In-house task API (Phase 3). Auth: POST {base_url}/login with
# {username, password, ignorePermissions} returns a bearer token.
# Never commit real credentials here — this file is a template, .env (gitignored) holds real values.
# crm.test.local below is the local/test system. Point this at the live URL in each
# environment's own .env when deploying to production — no code change needed, this
# is the only line that differs between environments.
TASK_API_BASE_URL=http://crm.test.local/api
TASK_API_USERNAME=
TASK_API_PASSWORD=
TASK_API_IGNORE_PERMISSIONS=true
TASK_API_SYNC_HOUR=6

# /get-orders (deployable-tasks import) is scoped to this team's hall + machine group.
TASK_API_DEPLOYABLE_HALL_ID=5
TASK_API_DEPLOYABLE_MACHINE_GROUP_ID=13

# Signs the login session cookie. MUST be overridden with a long random value in every
# real deployment: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=dev-only-insecure-secret-change-me
